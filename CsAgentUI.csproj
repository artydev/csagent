<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <DebugType>none</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Standalone tool projects and build output must not be compiled into the app. -->
    <Compile Remove="tools/**/*.cs" />
    <Compile Remove="obj/**/*.cs" />
    <Compile Remove="bin/**/*.cs" />
    <Compile Remove="vendor/**/*.cs" />
    <EmbeddedResource Remove="tools/**" />
    <None Remove="tools/**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="vendor\PhotinoX\Extensions.cs" />
    <Compile Include="vendor\PhotinoX\GlobalSuppressions.cs" />
    <Compile Include="vendor\PhotinoX\NativeDelegates.cs" />
    <Compile Include="vendor\PhotinoX\NativeMethods.Application.cs" />
    <Compile Include="vendor\PhotinoX\NativeMethods.Browser.cs" />
    <Compile Include="vendor\PhotinoX\NativeMethods.Callbacks.cs" />
    <Compile Include="vendor\PhotinoX\NativeMethods.cs" />
    <Compile Include="vendor\PhotinoX\NativeMethods.Dialogs.cs" />
    <Compile Include="vendor\PhotinoX\NativeMethods.Memory.cs" />
    <Compile Include="vendor\PhotinoX\NativeMethods.Notifications.cs" />
    <Compile Include="vendor\PhotinoX\NativeMethods.Window.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoApplication.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoApplication.Enums.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoApplication.EventArgs.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoApplication.Events.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoApplication.Extensions.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoApplication.Fluent.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoApplication.Fluent.Handlers.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoApplication.Helpers.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoApplication.NativeParameters.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoApplication.Notifications.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoApplication.RuntimeInfo.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoBootstrap.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoDialogEnums.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoDispatcher.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoDispatcher.States.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoDispatcher.Stats.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoMonitorStruct.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoWindow.Browser.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoWindow.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoWindow.CustomSchemes.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoWindow.Dialogs.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoWindow.Enums.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoWindow.EventArgs.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoWindow.Events.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoWindow.Extensions.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoWindow.Fluent.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoWindow.Fluent.Handlers.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoWindow.Helpers.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoWindow.NativeParameters.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoWindow.States.cs" />
    <Compile Include="vendor\PhotinoX\PhotinoWindowCollection.cs" />
    <Compile Include="vendor\PhotinoX\Platform.cs" />
    <Compile Include="vendor\PhotinoX\Platform.Linux.cs" />
    <Compile Include="vendor\PhotinoX\Platform.MacOS.cs" />
  </ItemGroup>


  <ItemGroup>
    <EmbeddedResource Include="src\Presentation\Web\assets\index.html" />
    <EmbeddedResource Include="src\Presentation\Web\assets\app.js" />
    <EmbeddedResource Include="src\Presentation\Web\assets\styles.css" />
    <EmbeddedResource Include="src\Presentation\DesktopPhotinoX\assets\index.html" />
    <EmbeddedResource Include="src\Presentation\DesktopPhotinoX\assets\app.js" />
    <EmbeddedResource Include="src\Presentation\DesktopPhotinoX\assets\styles.css" />
  </ItemGroup>


  <ItemGroup>
    <None Include="vendor\PhotinoX\PhotinoX.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- PhotinoX (maintained fork of Photino.NET) — vendored local project
         reference (vendor/PhotinoX). Provides the PhotinoApplication hosting
         model used by the desktop mode. The PhotinoX API (5.x) is not published
         to NuGet, so we vendor its source for portability. The PhotinoX code
         references its types via an extern alias (PhotinoX) to keep the
         namespace isolated. -->
    <ProjectReference Include="vendor\PhotinoX\PhotinoX.csproj" Aliases="PhotinoX" />
  </ItemGroup>

</Project>
