<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- AOT & Trimming Configuration -->
		<PublishAot>true</PublishAot>
		<TrimMode>full</TrimMode>
		<SelfContained>true</SelfContained>
		<OptimizationPreference>Size</OptimizationPreference>

		<!-- Disable Debug Symbols -->
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
		<StripSymbols>true</StripSymbols>
		<IlcGenerateDebugInfo>false</IlcGenerateDebugInfo>

		<!-- Disable Static Web Assets & Globalization -->
		<StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
		<InvariantGlobalization>true</InvariantGlobalization>

		<!-- Publish Configuration -->
		<PublishTrimmed>true</PublishTrimmed>
		<PublishSingleFile>true</PublishSingleFile>
		<PublishReadyToRun>false</PublishReadyToRun>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
		<IncludeSymbolsInSingleFile>false</IncludeSymbolsInSingleFile>
		<DebugSymbols>false</DebugSymbols>
	</PropertyGroup>

	<!-- Remove wwwroot from build -->
	<ItemGroup>
		<Compile Remove="wwwroot\**" />
		<Content Remove="wwwroot\**" />
		<EmbeddedResource Remove="wwwroot\**" />
		<None Remove="wwwroot\**" />
	</ItemGroup>

	<!-- Embed README -->
	<ItemGroup>
		<EmbeddedResource Include="README.md" />
	</ItemGroup>

	<!-- Clear publish folder before publish -->
	<Target Name="ClearPublishFolderBeforePublish" BeforeTargets="PrepareForPublish">
		<RemoveDir Directories="$(PublishDir)" Condition="Exists('$(PublishDir)')" />
	</Target>

	<!-- Embed UI assets -->
	<ItemGroup>
		<EmbeddedResource Include="src\UI\assets\index.html" />
		<EmbeddedResource Include="src\UI\assets\app.js" />
		<EmbeddedResource Include="src\UI\assets\styles.css" />
	</ItemGroup>

	<!-- Exclude config/data files from publish -->
	<ItemGroup>
		<Content Remove="agent_memory.json" />
		<None Remove="agent_memory.json" />
	</ItemGroup>

	<!-- Remove PDB and unwanted files BEFORE and AFTER publish -->
	<Target Name="RemovePdbBeforePublish" BeforeTargets="PrepareForPublish">
		<ItemGroup>
			<PdbFilesToDelete Include="$(PublishDir)*.pdb" />
			<PdbFilesToDelete Include="$(PublishDir)**\*.pdb" />
			<JsonFilesToDelete Include="$(PublishDir)*.json" />
			<JsonFilesToDelete Include="$(PublishDir)**\*.json" />
		</ItemGroup>
		<Delete Files="@(PdbFilesToDelete)" />
		<Delete Files="@(JsonFilesToDelete)" />
	</Target>

	<Target Name="RemovePdbAfterPublish" AfterTargets="Publish">
		<ItemGroup>
			<PdbFilesToDelete Include="$(PublishDir)*.pdb" />
			<PdbFilesToDelete Include="$(PublishDir)**\*.pdb" />
			<JsonFilesToDelete Include="$(PublishDir)*.json" />
			<JsonFilesToDelete Include="$(PublishDir)**\*.json" />
		</ItemGroup>
		<Delete Files="@(PdbFilesToDelete)" ContinueOnError="true" />
		<Delete Files="@(JsonFilesToDelete)" ContinueOnError="true" />
		<RemoveDir Directories="$(PublishDir)refs" Condition="Exists('$(PublishDir)refs')" />
		<Message Text="✓ Removed PDB, JSON, and ref files from publish output" Importance="high" />
	</Target>

</Project>