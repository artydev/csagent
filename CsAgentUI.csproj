<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- AOT & Trimming Configuration -->
		<PublishAot>true</PublishAot>
		<TrimMode>full</TrimMode>
		<SelfContained>true</SelfContained>
		<OptimizationPreference>Size</OptimizationPreference>

		<!-- Disable Debug Symbols -->
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
		<StripSymbols>true</StripSymbols>

		<!-- Disable Static Web Assets & Globalization -->
		<StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
		<InvariantGlobalization>true</InvariantGlobalization>

		<!-- Publish Configuration -->
		<PublishTrimmed>true</PublishTrimmed>
		<PublishSingleFile>true</PublishSingleFile>
		<PublishReadyToRun>false</PublishReadyToRun>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
	</PropertyGroup>

	<!-- Remove wwwroot from build -->
	<ItemGroup>
		<Compile Remove="wwwroot\**" />
		<Content Remove="wwwroot\**" />
		<EmbeddedResource Remove="wwwroot\**" />
		<None Remove="wwwroot\**" />
	</ItemGroup>

	<!-- Embed README -->
	<ItemGroup>
		<EmbeddedResource Include="README.md" />
	</ItemGroup>

	<!-- Clear publish folder before publish -->
	<Target Name="ClearPublishFolderBeforePublish" BeforeTargets="PrepareForPublish">
		<RemoveDir Directories="$(PublishDir)" Condition="Exists('$(PublishDir)')" />
	</Target>

	<!-- Remove PDB files after publish -->
	<Target Name="RemovePdbFilesAfterPublish" AfterTargets="Publish">
		<ItemGroup>
			<PdbFiles Include="$(PublishDir)**/*.pdb" />
		</ItemGroup>
		<Delete Files="@(PdbFiles)" />
		<Message Text="Removed PDB files from publish directory" Importance="high" />
	</Target>
	<ItemGroup>
		<EmbeddedResource Include="src\UI\assets\index.html" />
		<EmbeddedResource Include="src\UI\assets\app.js" />
		<EmbeddedResource Include="src\UI\assets\styles.css" />
	</ItemGroup>
</Project>

	

