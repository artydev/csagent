<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <DebugType>none</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Standalone tool projects and build output must not be compiled into the app. -->
    <Compile Remove="tools/**/*.cs" />
    <Compile Remove="obj/**/*.cs" />
    <Compile Remove="bin/**/*.cs" />
    <!-- Vendored PhotinoX source is compiled by its own project (see ProjectReference below). -->
    <Compile Remove="vendor/**/*.cs" />
    <EmbeddedResource Remove="tools/**" />
    <None Remove="tools/**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="src\Presentation\Web\assets\index.html" />
    <EmbeddedResource Include="src\Presentation\Web\assets\app.js" />
    <EmbeddedResource Include="src\Presentation\Web\assets\styles.css" />
    <EmbeddedResource Include="src\Presentation\DesktopPhotinoX\assets\index.html" />
    <EmbeddedResource Include="src\Presentation\DesktopPhotinoX\assets\app.js" />
    <EmbeddedResource Include="src\Presentation\DesktopPhotinoX\assets\styles.css" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- PhotinoX (maintained fork of Photino.NET) — vendored local project
         reference (vendor/PhotinoX). Provides the PhotinoApplication hosting
         model used by the desktop mode. The PhotinoX API (5.x) is not published
         to NuGet, so we vendor its source for portability. The PhotinoX code
         references its types via an extern alias (PhotinoX) to keep the
         namespace isolated. -->
    <ProjectReference Include="vendor\PhotinoX\PhotinoX.csproj" Aliases="PhotinoX" />
  </ItemGroup>

</Project>
