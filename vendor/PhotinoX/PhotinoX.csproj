<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Vendored copy of the PhotinoX fork (https://github.com/ivanvoyager/PhotinoX),
    a maintained fork of Photino.NET. This is a self-contained project so the
    csagent repo builds anywhere without depending on an external checkout.

    The PhotinoX API (5.x) is not published to NuGet, so we vendor its source
    here and reference it as a local project. Native binaries come from the
    PhotinoX.Native NuGet package, so this builds on any machine with NuGet
    access.

    NOTE: The PhotinoX assembly shares the Photino.NET namespace with the older
    Photino.NET 3.2.3 NuGet package. The csagent project references this project
    with an extern alias (PhotinoX) to avoid type ambiguity (CS0433).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Photino.NET</RootNamespace>
    <LangVersion>14</LangVersion>
    <NoWarn>$(NoWarn);1591;NETSDK1233</NoWarn>
    <VersionPrefix>5.0.4</VersionPrefix>
    <!-- We reference this as a local project, not a packable package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PhotinoX.Native" Version="5.0.3" />
  </ItemGroup>

</Project>
